# === CONFIGURACIÓN DE SITIO Y ANALYTICS FRONTEND ===
GOOGLE_ANALYTICS_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_WHATSAPP_CONVERSION_ID=
CLARITY_ID=
BASE_URL=https://datamaq.com.ar
DEBUG=False

# === CONTACTO Y WHATSAPP ===
WHATSAPP_PHONE=541156297160
WHATSAPP_MESSAGE="Hola! Quisiera realizar una consulta sobre las carreras e inscripciones del ISFT N° 199."

# === NOTIFICACIONES (TELEGRAM & EMAIL) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# === WATCHDOG DE OPERACIONES & ALERTAS (SCRIPTS) ===
# URL base que consulta el watchdog (en VPS systemd suele ser http://127.0.0.1:8001):
WATCHDOG_BASE_URL=http://127.0.0.1:8001
# Fallos consecutivos necesarios para emitir alerta por Telegram (debounce anti-falsos positivos):
WATCHDOG_CONSECUTIVE_FAILURES_REQUIRED=2

# === CACHÉ CLOUDFLARE (PURGA POST-DEPLOY) ===
# Token API con permiso Cache Purge y Zone ID de la zona datamaq.com.ar.
# Usadas por scripts/purge_cloudflare.py tras cada deploy.
CF_API_TOKEN=
CF_ZONE_ID=

# === BASE DE DATOS (LEADS) ===
# Local (SQLite sin dependencias externas):
DATABASE_URL=sqlite+aiosqlite:///data/leads.db
# Prod - VPS (MySQL):
# DATABASE_URL=mysql+aiomysql://datamaq:PASSWORD@127.0.0.1:3306/datamaq_leads

