{
  "include": [
    "src"
  ],
  "exclude": [
    "**/__pycache__",
    "venv",
    ".venv"
  ],
  "extraPaths": [
    "src"
  ],
  "venvPath": ".",
  "venv": "venv",
  "pythonVersion": "3.12",
  "typeCheckingMode": "standard",
  "reportUnknownVariableType": "error",
  "reportUnknownArgumentType": "warning",
  "reportUnknownLambdaType": "warning"
}
